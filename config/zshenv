# ~/.zshenv — se carga en TODA shell zsh (incluidas no interactivas).
# Aquí solo variables y PATH: nada que imprima salida.

export LANG="${LANG:-en_US.UTF-8}"
export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"
export LESS="-FRX"

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

# ~/.local/bin antes que el resto (ahí vive mise)
path=("$HOME/.local/bin" "$HOME/bin" $path)
typeset -U path PATH
